{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao-interna-yup",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  // Site (React + Vite, gerado em dist/). Só /api/* passa pelo código do Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // A cada 5 minutos o Worker processa os jobs devidos. Não faz nada enquanto a sincronização
    // automática estiver desligada (POST /api/sync/settings {"auto_enabled": true}).
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ERP_API_URL": "https://api.meuerponline.com.br/publica/api/consulta/sql/v1",
    "ERP_AUTH_SCHEME": "Authentication",
    "ERP_SEND_X_TOKEN": "false",
    "ERP_PAGINATION": "query",
    "ERP_PAGE_SIZE": "100",
    "ERP_UTC_OFFSET": "-03:00",
    "STORE_TIME_ZONE": "America/Belem",
    // Plano Free do Workers: 50 subrequests por invocação. No plano pago, pode subir (até 1000).
    "SYNC_MAX_SUBREQUESTS": "45"
  },
  "observability": { "enabled": true },
  "previews": {}
  // Secrets (nunca neste arquivo): ERP_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_TOKEN.
}
